MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dementia_face_memory
SESSION_SECRET=replace-with-a-random-64-character-secret
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_TOKEN=
DEVICE_SYNC_TOKEN=replace-with-a-long-random-device-sync-token

# Optional local Whisper transcription. Install `openai-whisper` and scipy in the model environment.
WHISPER_MODEL=small

# For Vercel, set secrets in Project Settings > Environment Variables.
# The model service URL is injected by the private service binding in vercel.json.
