[Unit]
Description=Offline Face Memory Assistant for Raspberry Pi 2
After=local-fs.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/face-memory
EnvironmentFile=/etc/face-memory-pi.env
ExecStart=/opt/face-memory/.venv/bin/python /opt/face-memory/pi/face_memory_pi.py --camera
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pi/.local/share/face-memory
PrivateTmp=true

[Install]
WantedBy=multi-user.target
